@startuml class-05-payment
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 70
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classHeaderFontStyle bold
hide circle
title SƠ ĐỒ LỚP (TASK 2.3): UC-05 - THANH TOÁN & IDEMPOTENCY

class Order {
  - id: String
  - orderCode: String
  {field} - status: String (PENDING/PAID/CANCELLED)
  - finalAmount: Decimal
  + markPaid(): void
  + cancel(): void
}
class Payment {
  - id: String
  - orderId: String
  - idempotencyKey: String
  - amount: Decimal
  {field} - method: String (VNPAY/MOMO/VIETQR)
  {field} - status: String (PENDING/SUCCESS/FAILED/REFUNDED)
  - transactionRef: String [0..1]
  - paidAt: DateTime [0..1]
  + markSuccess(txRef: String): void
  + markFailed(reason: String): void
}
class IdempotencyRecord {
  - id: String
  - key: String
  - endpoint: String
  - responseStatus: int
  - expiresAt: DateTime
  + isExpired(): boolean
}
class PaymentGateway {
  - merchantCode: String
  - secretKey: String
  + createPaymentUrl(order: Order): String
  + verifySignature(payload: Map): boolean
}
class Ingredient {
  - id: String
  - name: String
  - stockQuantity: Decimal
  - version: int
  + restock(amount: Decimal): void
}
class LoyaltyTransaction {
  - id: String
  - userId: String
  - orderId: String
  {field} - type: String (EARN/REFUND)
  - points: int
}

Order "1" -right-> "0..1" Payment
Payment "1" -down-> "0..1" IdempotencyRecord
Payment "0..*" -right-> "1" PaymentGateway
Order "1" -down-> "0..*" Ingredient
Order "1" -down-> "0..*" LoyaltyTransaction
@enduml
