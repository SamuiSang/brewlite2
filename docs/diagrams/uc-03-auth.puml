@startuml uc-03-auth
!pragma layout smetana
left to right direction

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam packageStyle rectangle

skinparam ArrowColor black
skinparam actorBorderColor black
skinparam actorBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam usecaseBorderColor black
skinparam rectangleBorderColor black
skinparam rectangleBackgroundColor white

skinparam nodesep 70
skinparam ranksep 90

title UC-03 - Sơ đồ Use Case: Đăng ký, Đăng nhập & Xác thực Phân quyền JWT (Đen - Trắng)

actor "Khách hàng vãng lai\n(Guest)" as Guest
actor "Khách hàng thành viên\n(Authenticated Customer)" as Customer

rectangle "BrewLite - Phân hệ Xác thực & Quản lý Tài khoản (FR-04)" {
    usecase "UC-03.1\nĐăng ký tài khoản mới" as UC_Register
    usecase "Đăng nhập tiếp tục đơn hàng\n(?redirect=/checkout)" as UC_RedirectLogin
    usecase "UC-03.2\nĐăng nhập hệ thống & Nhận JWT" as UC_Login
    usecase "UC-03.3\nXem hồ sơ & Điểm tích lũy\n(GET /api/v1/auth/me)" as UC_Profile
    
    usecase "Xác thực mật khẩu Bcrypt\n(Bcrypt compare/hash)" as UC_Bcrypt
    usecase "Cấp phát AccessToken (JWT)\n(Payload: sub, email, role)" as UC_IssueJWT
    usecase "Giám sát sức khỏe hệ thống\n(GET /api/v1/health)" as UC_Health

    UC_Login ..> UC_Bcrypt : <<include>>
    UC_Login ..> UC_IssueJWT : <<include>>
    UC_Register ..> UC_Bcrypt : <<include>>
    UC_Register ..> UC_IssueJWT : <<include>>
    UC_RedirectLogin ..> UC_Login : <<extend>>
}

Guest -- UC_Register
Guest -- UC_RedirectLogin
Guest -- UC_Login

Customer -- UC_Login
Customer -- UC_Profile

note right of UC_Health
  Kiểm tra kết nối DB (SELECT 1)
  Liveness & Readiness probe
end note

legend bottom
  Hệ thống BrewLite - Chuẩn đen trắng phục vụ in ấn báo cáo kỹ thuật.
  - Mật khẩu người dùng bắt buộc băm 1 chiều bằng Bcrypt (saltRounds >= 10).
  - Đăng nhập thành công cấp phát JWT Token (thời hạn 24h), tự động đính kèm Authorization: Bearer <token>.
  - Hỗ trợ tham số ?redirect=/checkout bảo toàn giỏ hàng khi khách vãng lai đăng nhập để tiếp tục thanh toán.
  - Endpoint GET /api/v1/health thực thi kiểm tra kết nối trực tiếp tới PostgreSQL.
endlegend
@enduml
