@startuml sequence-05-payment
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor white
skinparam sequenceParticipantBackgroundColor white
skinparam actorBackgroundColor white
<style>
participant {
  Padding 20
}
</style>
hide footbox
title SƠ ĐỒ TUẦN TỰ (TASK 2.2): UC-05 - THANH TOÁN & WEBHOOK

actor "Khách hàng" as C
participant "«giao diện»\n:Màn hình thanh toán" as UI
participant "«điều khiển»\n:Thanh toán" as Pay
participant "«thực thể»\n:Cơ sở dữ liệu" as DB
participant "«dịch vụ ngoài»\n:Cổng Sandbox" as GW

C -> UI: 1. Chọn cách & bấm Thanh toán
activate UI
UI -> Pay: Gửi yêu cầu thanh toán
activate Pay
Pay -> DB: Kiểm tra Idempotency-Key
activate DB
DB --> Pay: Kết quả kiểm tra
deactivate DB

alt Giao dịch trùng lặp
  Pay --> UI: Trả kết quả cũ
  UI --> C: Hiện kết quả cũ (không trừ 2 lần)
else Giao dịch mới
  Pay -> DB: 2. Lưu Payment PENDING
  activate DB
  DB --> Pay: Đã lưu
  deactivate DB

  Pay -> GW: 3. Tạo phiên Sandbox
  activate GW
  GW --> Pay: URL & mã QR
  deactivate GW
  Pay --> UI: Trả mã QR thanh toán
  UI --> C: Hiển thị mã QR

  C -> GW: 4. Quét QR thanh toán
  activate GW
  GW -> Pay: 5. Gửi Webhook (kèm HMAC)
  Pay -> Pay: Xác thực chữ ký HMAC

  alt Thanh toán thành công
    Pay -> DB: 6. Đổi PAID & cộng điểm
    activate DB
    DB --> Pay: Đã cập nhật
    deactivate DB
    Pay --> GW: Xác nhận Webhook OK
    Pay --> UI: Thanh toán thành công
    UI --> C: Hiện biên nhận (PAID)
  else Thất bại / Quá hạn 15p
    Pay -> DB: 6b. Hủy đơn & hoàn kho
    activate DB
    DB --> Pay: Đã hoàn kho
    deactivate DB
    Pay --> GW: Xác nhận Webhook OK
    Pay --> UI: Báo lỗi thanh toán
    UI --> C: Thông báo lỗi & thử lại
  end
  deactivate GW
end

deactivate Pay
deactivate UI
@enduml
