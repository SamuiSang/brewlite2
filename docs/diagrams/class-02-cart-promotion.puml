@startuml class-02-cart-promotion
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 70
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classHeaderFontStyle bold
hide circle
title SƠ ĐỒ LỚP (TASK 2.3): UC-02 - GIỎ HÀNG & KHUYẾN MÃI

class Cart {
  - items: CartItem[]
  - appliedPromotion: AppliedPromotion [0..1]
  + addItem(item: CartItem): void
  + updateQuantity(itemKey: String, quantity: int): void
  + removeItem(itemKey: String): void
  + clearCart(): void
  + removePromotion(): void
  + calculateSubtotal(): Decimal
  + calculateTotal(): Decimal
}
class CartItem {
  - itemKey: String
  - productId: String
  - productName: String
  - basePrice: Decimal
  {field} - size: String (S/M/L)
  - sizePrice: Decimal
  - sugar: int
  - ice: int
  - quantity: int
  + calculateLineTotal(): Decimal
}
class Topping {
  - id: String
  - name: String
  - price: Decimal
}
class AppliedPromotion {
  - promotionId: String
  - code: String
  - discountType: String
  - discountValue: Decimal
  - minOrderValue: Decimal
  - maxDiscountAmount: Decimal [0..1]
  - discountAmount: Decimal
}
class Promotion {
  - id: String
  - code: String
  {field} - discountType: String (PERCENTAGE/FIXED_AMOUNT)
  - discountValue: Decimal
  - minOrderValue: Decimal
  - maxDiscountAmount: Decimal [0..1]
  - usageLimit: int
  - usedCount: int
  - startDate: DateTime
  - endDate: DateTime
  - isActive: boolean
  + isValid(subtotal: Decimal, now: DateTime): boolean
  + calculateDiscount(subtotal: Decimal): Decimal
}
class Product {
  - id: String
  - name: String
  - basePrice: Decimal
  - isAvailable: boolean
  / availableStock: int
  + checkAvailability(quantity: int): boolean
}

Cart "1" *-down- "0..*" CartItem : chứa
Cart "1" *-right- "0..1" AppliedPromotion : áp dụng
CartItem "0..*" -down-> "0..*" Topping : chọn thêm
CartItem ..right.> Product : tham chiếu
AppliedPromotion ..down.> Promotion : lấy thông tin từ
@enduml
