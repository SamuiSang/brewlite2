@startuml uc-02-cart-promotion
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor white
skinparam packageStyle rectangle

title UC-02: Tùy biến đồ uống, Quản lý giỏ hàng và Áp mã khuyến mãi

actor "Khách hàng\n(Customer / Guest)" as Customer

rectangle "UC-02: Phân hệ Tùy biến đồ uống, Quản lý giỏ hàng và Khuyến mãi" {
  together {
    usecase "UC-02.1: Tùy biến đồ uống\n(Size, Topping, Đường, Đá)" as UC_Customize
    usecase "Tính giá tạm tính\ntheo tùy chọn" as UC_CalcPrice
    usecase "Thêm món vào giỏ hàng" as UC_AddToCart
  }
  
  together {
    usecase "UC-02.2: Quản lý giỏ hàng\n(Xem giỏ, điều chỉnh số lượng, xóa món)" as UC_ManageCart
    usecase "UC-02.4: Hủy áp dụng\nmã khuyến mãi" as UC_RemovePromo
    usecase "UC-02.3: Áp dụng mã khuyến mãi\n(Promotion)" as UC_ApplyPromo
  }
  
  together {
    usecase "Kiểm tra tồn kho khả dụng" as UC_CheckStock
    usecase "Kiểm tra điều kiện\nkhuyến mãi" as UC_ValidatePromo
  }

  Customer -- UC_Customize
  Customer -- UC_ManageCart

  UC_Customize ..> UC_CalcPrice : <<include>>
  UC_Customize <.. UC_AddToCart : <<extend>>\n[Khách hàng xác nhận thêm vào giỏ]
  UC_AddToCart ..> UC_CheckStock : <<include>>

  UC_ManageCart ..> UC_CheckStock : <<include>>
  UC_ManageCart <.. UC_RemovePromo : <<extend>>\n[Khách hàng yêu cầu hủy mã khuyến mãi]
  UC_ManageCart <.. UC_ApplyPromo : <<extend>>\n[Khách hàng nhập mã khuyến mãi]
  
  UC_ApplyPromo ..> UC_ValidatePromo : <<include>>
}

legend bottom
  Ghi chú nghiệp vụ:
  - Khách hàng tùy biến quy cách đồ uống (Size, Topping, khẩu vị) và xem giá tạm tính trước khi quyết định thêm vào giỏ.
  - Khách hàng quản lý giỏ hàng (xem giỏ, tăng/giảm số lượng, xóa món).
  - Khách hàng có thể áp dụng mã khuyến mãi hợp lệ hoặc yêu cầu hủy mã đang áp dụng.
endlegend
@enduml
