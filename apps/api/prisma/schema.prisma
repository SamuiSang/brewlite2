// ============================================================================
// BREWLITE - PRISMA RELATIONAL DATABASE SCHEMA (POSTGRESQL 16)
// Aligns 100% with Task 2.3 Class Diagram & Task 3 ADR-003, ADR-004, ADR-005
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductCategory {
  COFFEE
  TEA
  FREEZE
  PASTRY
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  MOMO
  VNPAY
  VIETQR
  CREDIT_CARD
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum LoyaltyTxType {
  EARN
  REDEEM
  REFUND
}

// ----------------------------------------------------------------------------
// 1. USER & AUTHENTICATION DOMAIN (Module 3 - Hieu)
// ----------------------------------------------------------------------------

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  fullName            String
  phone               String?
  passwordHash        String
  role                UserRole             @default(CUSTOMER)
  loyaltyPoints       Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

// ----------------------------------------------------------------------------
// 2. PRODUCT, RAW INGREDIENT & RECIPE BOM DOMAIN (Module 1 & 4 - Duy & Chien)
// (Strictly follows Lecture 28/10: Inventory stored as Raw Ingredients + RecipeItem)
// ----------------------------------------------------------------------------

model Product {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  category    ProductCategory
  basePrice   Decimal         @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean         @default(true)
  version     Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  recipeItems RecipeItem[]
  orderItems  OrderItem[]
}

model Ingredient {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  unit          String       // e.g. "g", "ml", "item"
  stockQuantity Decimal      @db.Decimal(10, 2)
  minThreshold  Decimal      @default(0) @db.Decimal(10, 2)
  version       Int          @default(0) // Optimistic Concurrency Control (OCC)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  recipeItems   RecipeItem[]
}

model RecipeItem {
  id               String     @id @default(uuid())
  productId        String
  ingredientId     String
  quantityRequired Decimal    @db.Decimal(10, 2)

  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
}

// ----------------------------------------------------------------------------
// 3. PROMOTION / VOUCHER DOMAIN (Module 2 - Quynh)
// ----------------------------------------------------------------------------

model Promotion {
  id                String       @id @default(uuid())
  code              String       @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderValue     Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  usageLimit        Int?
  firstOrderOnly    Boolean      @default(false)
  deliveryOnly      Boolean      @default(false)
  usedCount         Int          @default(0)
  isActive          Boolean      @default(true)
  startsAt          DateTime     @default(now())
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders            Order[]
}

// ----------------------------------------------------------------------------
// 4. ORDER & ORDER ITEM DOMAIN (Module 4 - Chien)
// ----------------------------------------------------------------------------

model Order {
  id                  String               @id @default(uuid())
  orderCode           String               @unique
  userId              String
  promotionId         String?
  status              OrderStatus          @default(PENDING)
  subtotalAmount      Decimal              @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(10, 2)
  loyaltyPointsUsed   Int                  @default(0)
  finalAmount         Decimal              @db.Decimal(10, 2)
  note                String?
  expiresAt           DateTime?            // Hold Stock TTL (e.g. 15 minutes)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  promotion           Promotion?           @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payment             Payment?
  statusLogs          OrderStatusLog[]
  loyaltyTransactions LoyaltyTransaction[]
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  productId     String
  productName   String
  size          String   @default("M")
  sugarLevel    String   @default("100%")
  iceLevel      String   @default("100%")
  toppingsJson  Json?
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2)
  lineTotal     Decimal  @db.Decimal(10, 2)

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// ----------------------------------------------------------------------------
// 5. SANDBOX PAYMENT, WEBHOOK & IDEMPOTENCY DOMAIN (Module 5 - Quang)
// ----------------------------------------------------------------------------

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @unique
  idempotencyKey String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  paymentUrl     String?
  qrCodeData     String?
  transactionRef String?
  webhookPayload Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model IdempotencyRecord {
  id             String            @id @default(uuid())
  key            String            @unique
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  expiresAt      DateTime
}

// ----------------------------------------------------------------------------
// 6. LOYALTY TRANSACTION & ORDER STATUS LOG DOMAIN (Module 6 - Sang)
// ----------------------------------------------------------------------------

model LoyaltyTransaction {
  id          String        @id @default(uuid())
  userId      String
  orderId     String?
  type        LoyaltyTxType
  points      Int
  description String?
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model OrderStatusLog {
  id             String      @id @default(uuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  changedBy      String?
  reason         String?
  createdAt      DateTime    @default(now())

  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
