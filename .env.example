# ==========================================
# BREWLITE - ENVIRONMENT VARIABLES TEMPLATE
# (Copy this file to .env for Local Dev; NEVER commit real .env to Git!)
# ==========================================

# 1. PostgreSQL 16 Database Configuration (Isolated DB Node)
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_secret_password
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://brewlite_user:brewlite_secret_password@localhost:5432/brewlite_db?schema=public"

# 2. NestJS Backend API Configuration (apps/api - Modular Monolith)
PORT=3001
API_PORT=3001
NODE_ENV=development
JWT_SECRET="replace-with-64-char-hex-secret-in-production"
JWT_EXPIRES_IN="24h"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# 3. Sandbox Payment Gateway & Webhook HMAC Configuration (UC-05)
SANDBOX_GATEWAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
WEBHOOK_SECRET="replace-with-sandbox-hmac-sha256-webhook-secret"
ORDER_HOLD_TTL_MINUTES=15

# 4. Next.js Mobile-first PWA Configuration (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="BrewLite"
