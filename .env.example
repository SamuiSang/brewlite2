# ==========================================
# BREWLITE - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. PostgreSQL Database Configuration
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_secret_password
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://brewlite_user:brewlite_secret_password@localhost:5432/brewlite_db?schema=public"

# 2. NestJS Backend API Configuration (apps/api)
API_PORT=3001
NODE_ENV=development
JWT_SECRET="replace-with-strong-secret-key-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# 3. Next.js Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="BrewLite"
